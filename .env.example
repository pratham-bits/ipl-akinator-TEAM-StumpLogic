# .env.example
# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT VARIABLES TEMPLATE
#
# HOW TO USE:
#   1. Copy this file : cp .env.example .env
#   2. Fill in your actual API keys in .env
#   3. NEVER commit .env to Git — it contains secrets
#      (The .gitignore file already excludes it)
#
# WHY .env AND NOT HARDCODING KEYS IN CODE?
#   - Security: hardcoded keys in code get accidentally pushed to GitHub
#   - Flexibility: different keys for dev vs production without changing code
#   - python-dotenv loads these automatically when the app starts
# ─────────────────────────────────────────────────────────────────────────────

# Claude API Key — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyB2IOBOY8X-JZfc2g1M5LX1wL3aaykco7c

# App settings
APP_ENV=development           # development | production
MAX_QUESTIONS=8               # Max questions before forced guess
CONFIDENCE_THRESHOLD=0.80     # Guess when confidence >= this value
